#include "../7zVersion.h"
#include "../../CPP/7zip/ForkConfig.h"

#define Z7_FORK_INSTALLER_VERSION_INFO(descr, original) \
LANGUAGE 9, 1 \
1 VERSIONINFO \
FILEVERSION 1,0,0,0 \
PRODUCTVERSION 1,0,0,0 \
FILEFLAGSMASK 0x3fL \
FILEFLAGS 0 \
FILEOS 0x40004L \
FILETYPE 1 \
FILESUBTYPE 0 \
BEGIN \
  BLOCK "StringFileInfo" \
  BEGIN \
    BLOCK "040904b0" \
    BEGIN \
      VALUE "CompanyName", "pa4H" \
      VALUE "FileDescription", descr \
      VALUE "FileVersion", Z7_FORK_VERSION \
      VALUE "LegalCopyright", MY_COPYRIGHT_CR "; fork Copyright (c) 2026 pa4H" \
      VALUE "OriginalFilename", original \
      VALUE "ProductName", "7-Zip Updated" \
      VALUE "ProductVersion", Z7_FORK_VERSION \
    END \
  END \
  BLOCK "VarFileInfo" \
  BEGIN \
    VALUE "Translation", 0x409, 1200 \
  END \
END
